# Docker Compose overrides.
#
# Base configuration comes from .env.
# This file only changes addresses that must resolve through the
# Docker Compose networks instead of localhost.

# --- postgres --------------------------------------------------------------
POSTGRES_DSN=postgres://ocr_gateway_app:devpassword@data-postgres:5432/ocr_gateway?sslmode=disable

# --- redis -----------------------------------------------------------------
REDIS_ADDR=data-redis:6379

# --- kafka -----------------------------------------------------------------
KAFKA_BROKERS=messaging-kafka:9092

# --- opentelemetry ---------------------------------------------------------
# The containers reach the OTel Collector through the shared observability
# Docker network using the collector service name.
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-otel-collector:4317

# --- grpc ------------------------------------------------------------------
# The OCR engine is expected to expose Kontrak B from this container address.
# Keep the gateway and engine attached to at least one shared Docker network.
OCR_GRPC_TARGET=ocr-grpc:9094
